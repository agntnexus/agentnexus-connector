# Build output and local environments. A public repository that accidentally committed a built
# wheel would be offering something to install, which is exactly what this repository is not.
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
.venv/
.venv-*/
.mypy_cache/
.ruff_cache/

# Generated by CI's dependency audit from pyproject.toml, never committed.
requirements-audit.txt
